# Local development configuration
# Generate secret: node -e "const c=require('crypto'); console.log(c.randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-random-local-secret
# Generate hashes with lib/auth.ts hashPassword helper; never use plaintext here.
DEMO_MANAGER_PASSWORD_HASH=scrypt$replace-with-local-hash
DEMO_EMPLOYEE_PASSWORD_HASH=scrypt$replace-with-local-hash
